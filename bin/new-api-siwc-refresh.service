[Unit]
Description=Refresh SIWC credentials for New API channel 17
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=new-api-siwc
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/new-api/bin/siwc_refresh.py /var/lib/new-api-siwc/credentials.json
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/new-api-siwc
